{
  "name": "site-locations-en-direct",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site de réservation directe pour locations courte durée (Astro, statique, GitHub Pages).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "preparer": "node scripts/preparer.mjs",
    "dev": "node scripts/preparer.mjs && astro dev",
    "build": "node scripts/preparer.mjs && astro build && node scripts/apres-build.mjs",
    "preview": "astro preview",
    "valider": "node scripts/preparer.mjs --validation-seule",
    "test": "node --test tests/*.test.mjs paiement-worker/tests/*.test.mjs",
    "synchro": "node scripts/synchro-calendriers.mjs",
    "cms": "node scripts/generer-pages-cms.mjs",
    "verifier-liens": "node scripts/apres-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@lucide/astro": "1.65.0",
    "astro": "7.4.4",
    "leaflet": "1.9.4",
    "markdown-it": "15.0.3",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "html-validate": "11.17.0"
  }
}
